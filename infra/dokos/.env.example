# dokos — variables d'environnement attendues
# Copier en .env et renseigner les valeurs réelles.
# Le fichier .env n'est jamais committé.

# Identifiant du projet Compose (préfixe des conteneurs, volumes et réseaux)
COMPOSE_PROJECT_NAME=erppoc-dokos

# Version épinglée de l'image (jamais latest)
IMAGE_TAG=

# Base de données
DB_NAME=
DB_USER=
DB_PASSWORD=

# Compte administrateur applicatif
ADMIN_USER=
ADMIN_PASSWORD=

# Port publié sur l'hôte (voir docs/installation.md)
HTTP_PORT=
