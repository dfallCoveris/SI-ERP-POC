# Tryton — variables d'environnement
# Copier en .env et renseigner. Le fichier .env n'est jamais committé.

# --- Versions épinglées ---------------------------------------------------
# Série 8.0 (long support, sortie le 20/04/2026), variante -office nécessaire
# à la conversion OpenDocument vers PDF (test 13).
# Relever la dernière version corrective de la série au moment de l'installation :
# une vulnérabilité sur le rendu HTML vers PDF a été corrigée en 2026.
TRYTON_TAG=8.0-office
POSTGRES_TAG=16

# --- Base de données ------------------------------------------------------
DB_NAME=tryton
DB_USER=tryton
DB_PASSWORD=

# --- Compte administrateur applicatif -------------------------------------
# Renseigné à l'initialisation de la base (voir README).
# Ne jamais inscrire le mot de passe ici en clair une fois l'environnement en service.

# --- Réseau ---------------------------------------------------------------
# Port publié sur 127.0.0.1 uniquement. Plage POC : voir docs/installation.md
HTTP_PORT=8210

# Sous-réseau Docker dédié. Vérifier l'absence de conflit avant de démarrer.
DOCKER_SUBNET=172.30.10.0/24
